// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// LihLih Platform Data Model
// Phase 1: Core Logistics & Discovery

model Client {
  id           Int      @id @default(autoincrement())
  name         String
  phone_number String   @unique
  wilaya       String?
  baladia      String?
  default_lat  Decimal?
  default_lng  Decimal?
  created_at   DateTime @default(now())
  orders       Order[]
  reviews      Review[]
}

model Store {
  id              Int       @id @default(autoincrement())
  name            String
  phone_number    String    @unique
  is_open         Boolean   @default(false)
  wilaya          String?
  baladia         String?
  street          String?
  address1        String?
  address2        String?
  lat             Decimal?
  lng             Decimal?
  tags            String?   
  image_url       String?   // Discovery cover photo
  rating          Float     @default(5.0)
  sub_valid_until DateTime?
  
  // Rating Counters (Running Totals)
  review_count    Int       @default(0)
  sum_quality     Int       @default(0)
  sum_accuracy    Int       @default(0)
  sum_packaging   Int       @default(0)
  sum_value       Int       @default(0)
  sum_speed       Int       @default(0)
  total_orders_count Int      @default(0)
  
  orders          Order[]
  menu_items      Item[]
  reviews         Review[]
  updated_at      DateTime  @default(now()) @updatedAt
}

// Central registry for tracking versions of global entities
model SystemRegistry {
  key     String @id
  version Int    @default(1)
}

// THE Store's Menu
model Item {
  id           Int      @id @default(autoincrement())
  store_id     Int
  name         String
  description  String?
  price        Decimal
  category     String   @default("Général")
  stock_count  Int?     
  is_available Boolean  @default(true)
  total_sold_count Int      @default(0)
  
  store        Store    @relation(fields: [store_id], references: [id])
}

model Driver {
  id             Int      @id @default(autoincrement())
  name           String
  phone_number   String   @unique
  plate_number   String
  id_card_number String?  // National ID / Carte d'identité
  license_number String?  // Permis de conduire
  
  // platform_debt was removed as per the Zero-Charge business model
  
  orders         Order[]
}

model Order {
  id           Int      @id @default(autoincrement())
  client_id    Int
  store_id     Int
  driver_id    Int?     // Optional because a driver isn't assigned immediately
  status       String   @default("Pending") // Pending, Preparing, Accepted, Picked_Up, Arriving, Delivered, Cancelled
  dropoff_lat     Decimal
  dropoff_lng     Decimal
  dropoff_wilaya  String
  dropoff_baladia String
  dropoff_street  String?
  food_total      Decimal
  delivery_fee    Decimal? // Filled by the driver later
  grand_total     Decimal? // Calculated later
  delivery_pin    String   // The 4-digit OTP for the client
  pickup_pin      String?  // The 4-digit OTP for the store-to-driver handover
  instructions    String?  // Special requests (e.g., "No onions", "Add extra cheese")
  created_at      DateTime @default(now())
  
  // Relations linking to the other tables
  client       Client   @relation(fields: [client_id], references: [id])
  store        Store    @relation(fields: [store_id], references: [id])
  driver       Driver?  @relation(fields: [driver_id], references: [id])
  items        OrderItem[]
  disputes     Dispute[]
  review       Review?
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  order_id   Int
  food_name  String
  quantity   Int
  unit_price Decimal
  
  order      Order   @relation(fields: [order_id], references: [id])
}

// To handle customer support and issues
model Dispute {
  id          Int       @id @default(autoincrement())
  order_id    Int
  raised_by   String    // Who complained? 'Client', 'Store', or 'Driver'
  reason      String    // E.g., 'Missing items', 'Client refused to pay', 'Cold food'
  status      String    @default("Open") // Open, Investigating, Resolved
  created_at  DateTime  @default(now())
  resolved_at DateTime?
  
  order       Order     @relation(fields: [order_id], references: [id])
}

model Review {
  id               Int      @id @default(autoincrement())
  order_id         Int      @unique
  store_id         Int
  client_id        Int
  rating_quality   Int      @default(0)
  rating_accuracy  Int      @default(0)
  rating_packaging Int      @default(0)
  rating_value     Int      @default(0)
  rating_speed     Int      @default(0)
  comment          String?
  created_at       DateTime @default(now())

  order            Order    @relation(fields: [order_id], references: [id])
  client           Client   @relation(fields: [client_id], references: [id])
  store            Store    @relation(fields: [store_id], references: [id])
}

model Wilaya {
  id        Int       @id @default(autoincrement())
  code      String    @unique // e.g., "17" for Djelfa
  name      String    @unique
  is_active Boolean   @default(false)
  baladias  Baladia[]
}

model Baladia {
  id        Int     @id @default(autoincrement())
  wilaya_id Int
  name      String
  is_active Boolean @default(false)
  wilaya    Wilaya  @relation(fields: [wilaya_id], references: [id])

  @@unique([wilaya_id, name])
}