{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "rootDir": "./",
    "outDir": "./dist",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*", "*.ts"]
}
